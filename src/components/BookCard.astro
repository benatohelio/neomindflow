---
interface Props {
  asin: string;
  title: string;
  author: string;
  isbn?: string;
}

const { asin, title, author, isbn = asin } = Astro.props;
const cover = `https://covers.openlibrary.org/b/isbn/${isbn}-M.jpg`;
const link = `https://www.amazon.com/dp/${asin}?tag=neomindflo-20`;
---

<div class="book-card">
  <img class="book-cover" src={cover} alt={`Cover of ${title}`} loading="lazy" width="80" height="120" />
  <div class="book-info">
    <h3 class="book-title">
      <a href={link} rel="sponsored nofollow" target="_blank">{title}</a>{' '}
      <span class="book-author">— {author}</span>
    </h3>
    <div class="book-body">
      <slot />
    </div>
    <a class="book-cta" href={link} rel="sponsored nofollow" target="_blank">Check price on Amazon →</a>
  </div>
</div>

<style>
  .book-card {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    padding: 1.25rem 0;
  }
  .book-cover {
    width: 80px;
    height: 120px;
    object-fit: cover;
    border-radius: 4px;
    box-shadow: 0 1px 4px rgba(23, 21, 15, 0.15);
    flex-shrink: 0;
  }
  .book-info {
    flex: 1;
  }
  .book-title {
    font-size: 1.3rem;
    margin: 0 0 0.5rem;
  }
  .book-title a {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in srgb, currentColor 35%, transparent);
  }
  .book-title a:hover {
    color: var(--color-primary);
    text-decoration-color: currentColor;
  }
  .book-author {
    font-weight: 400;
    color: var(--color-text-muted);
    font-size: 0.95em;
  }
  .book-body :global(p) {
    margin: 0 0 0.75rem;
    font-size: 1.05rem;
    line-height: 1.7;
  }
  .book-body :global(strong) {
    font-weight: 600;
  }
  .book-cta {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-primary);
  }
  .book-cta:hover {
    color: var(--color-primary-hover);
  }
</style>
