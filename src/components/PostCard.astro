---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const slug = post.id.replace(/^.*\//, '').replace(/\.(md|mdx)$/, '');
const base = import.meta.env.BASE_URL;

const words = post.body?.trim().split(/\s+/).length ?? 0;
const readingTime = Math.max(1, Math.round(words / 200));
---

<a class={`post-card ${featured ? 'post-card--featured' : ''}`} href={`${base}blog/${slug}/`}>
  <article>
    {
      featured && post.data.image && (
        <img class="post-card-img" src={post.data.image} alt="" loading="lazy" />
      )
    }
    {featured && <p class="post-card-eyebrow">Featured</p>}
    <div class="post-card-meta">
      {
        post.data.tags.length > 0 && (
          <span class="post-card-tag">{post.data.tags[0]}</span>
        )
      }
      <span class="post-card-divider" aria-hidden="true">·</span>
      <time datetime={post.data.pubDate.toISOString()}>
        {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
      </time>
      <span class="post-card-divider" aria-hidden="true">·</span>
      <span>{readingTime} min read</span>
    </div>
    <h2 class="post-card-title">{post.data.title}</h2>
    <p class="post-card-desc">{post.data.description}</p>
  </article>
</a>

<style>
  .post-card {
    display: block;
    padding: 1.75rem 0;
    border-top: 1px solid var(--color-border);
    color: inherit;
  }
  .post-card:hover {
    color: inherit;
    text-decoration: none;
  }
  .post-card--featured {
    border-top: none;
    padding-top: 0;
  }
  .post-card-img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    margin-bottom: 1.25rem;
  }
  .post-card-eyebrow {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin: 0 0 0.5rem;
  }
  .post-card-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }
  .post-card-tag {
    color: var(--color-primary);
    font-weight: 600;
    text-transform: capitalize;
  }
  .post-card-divider {
    color: var(--color-border);
  }
  .post-card-title {
    font-size: 1.5rem;
    margin: 0 0 0.4rem;
    transition: color 0.18s ease;
  }
  .post-card--featured .post-card-title {
    font-size: 2.6rem;
  }
  .post-card:hover .post-card-title {
    color: var(--color-primary);
  }
  .post-card-desc {
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.55;
    font-size: 1.05rem;
  }
  .post-card--featured .post-card-desc {
    font-size: 1.2rem;
  }
</style>
