---
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
const home = base.endsWith('/') ? base : `${base}/`;
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <p class="footer-title">Neo Mind Flow<span class="dot">.</span></p>
      <p class="footer-tag">Think — and live — a little better.</p>
    </div>
    <nav class="footer-links" aria-label="Footer">
      <a href={home}>Home</a>
      <a href={`${home}about/`}>About</a>
      <a href={`${home}rss.xml`}>RSS</a>
    </nav>
  </div>
  <div class="container footer-bottom">
    <p class="disclaimer">
      Neo Mind Flow is reader-supported. When you buy through links on our site,
      we may earn an affiliate commission. This does not affect the price you pay.
      As an Amazon Associate I earn from qualifying purchases.
    </p>
    <p class="copyright">© {year} Neo Mind Flow. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 3.5rem;
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-subtle);
    padding: 3rem 0 2rem;
  }
  .footer-inner {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .footer-title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.15rem;
    margin: 0;
    color: var(--color-text);
  }
  .footer-title .dot {
    color: var(--color-primary);
  }
  .footer-tag {
    margin: 0.25rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
  .footer-links {
    display: flex;
    gap: 1.25rem;
    font-family: var(--font-sans);
    font-size: 0.9rem;
  }
  .footer-links a {
    color: var(--color-text-muted);
  }
  .footer-links a:hover {
    color: var(--color-text);
  }
  .footer-bottom {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }
  .disclaimer {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    line-height: 1.5;
    margin-bottom: 0.75rem;
  }
  .copyright {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    margin: 0;
  }
</style>
