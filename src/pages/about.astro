---
import Layout from '../layouts/Layout.astro';
import { AUTHOR } from '../data/author';
---

<Layout title="About — Neo Mind Flow" description="About Neo Mind Flow, an independent editorial publication on self-improvement and books.">
  <main class="container about">
    <h1 class="about-title">About Neo Mind Flow</h1>
    <p class="lead">
      Neo Mind Flow is an independent editorial publication covering self-improvement,
      personal growth, and the books that actually move the needle.
    </p>
    <p>
      We research, compare, and distill the most recommended titles so you can spend
      less time browsing and more time applying what works. Every recommendation is
      grounded in what a book actually delivers, who it's for, and when it's worth
      your time.
    </p>

    <section class="author">
      <img class="author-avatar" src={`${import.meta.env.BASE_URL}icon-512.png`} alt="Neo Mind Flow mark" width="64" height="64" />
      <div class="author-info">
        <h2>{AUTHOR.name}</h2>
        <p class="role">{AUTHOR.role}</p>
        <p class="bio">{AUTHOR.bio}</p>
      </div>
    </section>

    <p>
      <a href={import.meta.env.BASE_URL}>← Back home</a>
    </p>
  </main>
</Layout>

<style>
  .about {
    padding-top: 4rem;
    padding-bottom: 4rem;
  }
  .about-title {
    font-size: 2.2rem;
    margin-bottom: 1rem;
  }
  .lead {
    font-size: 1.2rem;
    color: var(--color-text-muted);
    max-width: var(--measure);
  }
  .about p {
    max-width: var(--measure);
  }
  .author {
    margin-top: 2.5rem;
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    padding: 1.75rem;
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    max-width: var(--measure);
  }
  .author-avatar {
    width: 64px;
    height: 64px;
    border-radius: 12px;
    flex-shrink: 0;
  }
  .author-info h2 {
    font-size: 1.3rem;
    margin: 0 0 0.2rem;
  }
  .role {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    margin: 0 0 0.5rem;
  }
  .bio {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0;
  }
</style>
