---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { AUTHOR } from '../../data/author';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id.replace(/^.*\//, '').replace(/\.(md|mdx)$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const base = import.meta.env.BASE_URL;
const site = Astro.site ?? new URL('https://blog.neomindflow.cloud');
const canonical = new URL(Astro.url.pathname, site).toString();

const words = post.body?.trim().split(/\s+/).length ?? 0;
const readingTime = Math.max(1, Math.round(words / 200));

const related = (await getCollection('blog', ({ data }) => !data.draft))
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const slug = (id: string) => id.replace(/^.*\//, '').replace(/\.(md|mdx)$/, '');
const postSlug = slug(post.id);

const slugify = (s: string) => s.toLowerCase().trim().replace(/[^\w\s-]/g, '').replace(/\s+/g, '-');

const toc = [...(post.body ?? '').matchAll(/^##\s+(.+)$/gm)]
  .map((m) => m[1].trim().replace(/<[^>]+>/g, ''))
  .filter(Boolean)
  .map((text) => ({ text, id: slugify(text) }));

const faqBlock = (post.body ?? '').split('## Frequently asked questions')[1];
const faqs = faqBlock
  ? [...faqBlock.matchAll(/###\s+(.+)\n+([\s\S]*?)(?=\n###|\n##|$)/g)].map((m) => ({
      q: m[1].trim().replace(/<[^>]+>/g, ''),
      a: m[2].trim().replace(/<[^>]+>/g, '').replace(/\n{2,}/g, ' '),
    }))
  : [];
---

<Layout
  title={`${post.data.title} — Neo Mind Flow`}
  description={post.data.description}
  image={post.data.image ?? `covers/${postSlug}-og.png`}
  type="article"
>
  <article class="container post">
    <header class="post-header">
      {
        post.data.tags.length > 0 && (
          <div class="post-tags">
            {post.data.tags.map((tag) => (
              <a class="post-tag" href={`${base}tags/${tag.toLowerCase().replace(/\s+/g, '-')}/`}>{tag}</a>
            ))}
          </div>
        )
      }
      <h1 class="post-title">{post.data.title}</h1>
      <p class="post-desc">{post.data.description}</p>
      <div class="post-meta">
        <span>By <a class="post-author" href={`${base}about/`}>{post.data.author}</a></span>
        <span aria-hidden="true">·</span>
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        <span aria-hidden="true">·</span>
        <span>{readingTime} min read</span>
      </div>
    </header>

    {
      toc.length > 0 && (
        <nav class="toc" aria-label="Table of contents">
          <p class="toc-title">On this page</p>
          <ol>
            {toc.map((h) => (
              <li><a href={`#${h.id}`}>{h.text}</a></li>
            ))}
          </ol>
        </nav>
      )
    }

    <aside class="affiliate-note">
      <strong>Reader-supported.</strong> Some links in this article are affiliate links —
      if you buy through them, we may earn a commission at no extra cost to you.
      As an Amazon Associate I earn from qualifying purchases.
    </aside>

    <div class="prose">
      <Content />
    </div>

    {
      related.length > 0 && (
        <nav class="related" aria-label="More articles">
          <h2>Keep reading</h2>
          <ul>
            {related.map((p) => (
              <li>
                <a href={`${base}blog/${slug(p.id)}/`}>
                  <span>{p.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <aside class="author-box">
      <img class="author-avatar" src={`${base}icon-512.png`} alt="" width="48" height="48" loading="lazy" />
      <div class="author-info">
        <p class="author-name">{post.data.author}</p>
        <p class="author-bio">{AUTHOR.bio}</p>
      </div>
    </aside>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate.toISOString(),
    dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
    url: canonical,
    author: { '@type': 'Organization', name: post.data.author, url: new URL(base + 'about/', site).toString() },
  })} />

  {
    faqs.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqs.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      })} />
    )
  }
</Layout>

<style>
  .post {
    padding-top: 3rem;
    padding-bottom: 2rem;
  }
  .post-header {
    max-width: var(--measure);
    margin-inline: auto;
    margin-bottom: 2.5rem;
  }
  .post-tags {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }
  .post-tag {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-primary);
    text-transform: capitalize;
  }
  .post-tag + .post-tag::before {
    content: '·';
    color: var(--color-text-muted);
    margin-right: 0.5rem;
  }
  .post-title {
    font-size: clamp(1.9rem, 4.5vw, 2.6rem);
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
  }
  .post-desc {
    color: var(--color-text-muted);
    font-size: 1.2rem;
    line-height: 1.5;
    margin-bottom: 1rem;
  }
  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }
  .prose {
    font-size: 1.1875rem;
    line-height: 1.75;
    margin-inline: auto;
  }
  .prose :global(h2) {
    margin-top: 2.25rem;
    font-size: 1.6rem;
    scroll-margin-top: 5rem;
  }
  .prose :global(h3) {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    font-size: 1.3rem;
    scroll-margin-top: 5rem;
  }
  .prose :global(p) {
    margin: 1.25rem 0;
  }
  .prose :global(blockquote) {
    margin: 1.5rem 0;
    padding: 0.25rem 0 0.25rem 1.25rem;
    border-left: 3px solid var(--color-primary);
    color: var(--color-text-muted);
    font-style: italic;
  }
  .prose :global(a) {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in srgb, currentColor 35%, transparent);
  }
  .prose :global(a:hover) {
    text-decoration-color: currentColor;
  }
  .affiliate-note {
    max-width: var(--measure);
    margin: 0 auto 2.5rem;
    padding: 1.1rem 1.35rem;
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    font-family: var(--font-sans);
    font-size: 0.82rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }
  .toc {
    max-width: var(--measure);
    margin: 0 auto 2.5rem;
    padding: 1.1rem 1.35rem;
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }
  .toc-title {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0 0 0.5rem;
  }
  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .toc li {
    padding: 0.15rem 0;
  }
  .toc a {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--color-text);
  }
  .toc a:hover {
    color: var(--color-primary);
  }
  .related {
    max-width: var(--measure);
    margin: 3rem auto 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }
  .related h2 {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }
  .related ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .related li {
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .related li:last-child {
    border-bottom: none;
  }
  .related a {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.05rem;
  }
  .post-author {
    font-family: var(--font-sans);
    color: var(--color-text);
    font-weight: 600;
  }
  .author-box {
    max-width: var(--measure);
    margin: 3rem auto 0;
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.5rem;
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }
  .author-avatar {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    flex-shrink: 0;
  }
  .author-info {
    font-family: var(--font-sans);
  }
  .author-name {
    margin: 0 0 0.25rem;
    font-weight: 600;
    color: var(--color-text);
  }
  .author-bio {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--color-text-muted);
  }
</style>
