---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="Neo Mind Flow — Self Improvement & Books" description="Practical self-improvement guides, honest book recommendations, and personal growth ideas that actually work.">
  <section class="hero">
    <div class="container hero-inner">
      <h1 class="hero-title">Think — and live — a little better.</h1>
      <p class="hero-sub">
        Honest book recommendations, practical self-improvement guides, and ideas
        to help you grow, one step at a time.
      </p>
    </div>
  </section>

  <main class="container">
    <div class="section-head">
      <h2 class="section-title">Latest articles</h2>
    </div>
    <div class="post-list">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </main>
</Layout>

<style>
  .hero {
    padding: 4.5rem 0 3rem;
    border-bottom: 1px solid var(--color-border);
  }
  .hero-inner {
    text-align: center;
  }
  .hero-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    background: var(--gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 1rem;
  }
  .hero-sub {
    color: var(--color-text-muted);
    max-width: 520px;
    margin: 0 auto;
    font-size: 1.15rem;
  }
  .section-head {
    padding: 2.5rem 0 0.5rem;
  }
  .section-title {
    font-size: 1.05rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }
</style>
