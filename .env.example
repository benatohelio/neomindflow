# Analytics / verificação — preencha os valores e renomeie para `.env`.
# Se deixar vazio, o site roda normalmente sem analytics (não quebra).

# Google Search Console — token de verificação (conteúdo da meta tag "google-site-verification")
PUBLIC_GSC_VERIFICATION=

# Google Analytics (GA4) — Measurement ID (ex.: G-XXXXXXXXXX)
PUBLIC_GA4_ID=

# Microsoft Clarity — Project ID
PUBLIC_CLARITY_ID=

# URL canônica do site
PUBLIC_SITE_URL=https://blog.neomindflow.cloud
